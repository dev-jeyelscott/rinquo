# Local development defaults for the Docker Compose stack (compose.yaml).
# Copy to .env. Values here are safe local-only placeholders, never real
# secrets. Every variable is documented in docs/operations/environments.md.

APP_NAME=Rinquo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Host ports published by compose.yaml.
APP_PORT=80
VITE_PORT=5173

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=rinquo
DB_USERNAME=rinquo
DB_PASSWORD=rinquo-local-password
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=2

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=1
REDIS_READ_TIMEOUT=2

# Mailtrap Email Sandbox (SMTP). Each developer adds their own inbox
# credentials from Mailtrap > Sandboxes > SMTP settings. Never commit them.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@rinquo.test"
MAIL_FROM_NAME="${APP_NAME}"

# Resend is used in staging and production (MAIL_MAILER=resend).
RESEND_API_KEY=

# Local S3-compatible emulator (RustFS, service "s3" in compose.yaml).
AWS_ACCESS_KEY_ID=rinquo-local
AWS_SECRET_ACCESS_KEY=rinquo-local-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=rinquo-local
AWS_ENDPOINT=http://s3:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Reverb. REVERB_HOST/PORT/SCHEME are the server-to-Reverb path (internal
# Compose network). REVERB_PUBLIC_* are what browsers use: the web server
# proxies /app and /apps to Reverb on the same host and port as the app.
REVERB_APP_ID=rinquo-local
REVERB_APP_KEY=rinquo-local-key
REVERB_APP_SECRET=rinquo-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_PORT=8080
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=80
REVERB_PUBLIC_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost
